# ==========================================================
# Gene Tents Ltd – force HTTPS (Apache / cPanel hosting)
# Upload this file to the same folder as index.html
# (usually public_html). Install the SSL certificate FIRST.
# ==========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Send all http:// traffic to https:// (permanent redirect)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. OPTIONAL: always use the non-www address.
  #    Remove the # at the start of the next two lines to turn it on.
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# 3. OPTIONAL: tell browsers to always use HTTPS (HSTS).
#    Only turn this on once https works perfectly on your whole site,
#    because browsers remember it for a year.
# <IfModule mod_headers.c>
#   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
# </IfModule>

# 4. Use index.html as the home page
DirectoryIndex index.html
